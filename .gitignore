# Environment & Secret Files (Keep .env.example tracked)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Dependency Directories
node_modules/
backend/node_modules/
frontend/node_modules/

# Production Build Outputs
dist/
build/
backend/dist/
frontend/dist/

# Log Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Configuration
.idea/
*.sublime-project
*.sublime-workspace

# Runtime Uploads (Ignore uploaded media files, keep folder via .gitkeep)
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# Cache & Temporary Files
.vite/
*.tsbuildinfo
scratch/
.cache/
coverage/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
